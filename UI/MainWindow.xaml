<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Another's Toolbox" Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" AllowsTransparency="False"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- ============================ PALETA ============================ -->
    <Color x:Key="cDeep">#FF07405E</Color>
    <Color x:Key="cInk">#FF0B5C8A</Color>
    <Color x:Key="cSky1">#FFBFE9FB</Color>
    <Color x:Key="cSky2">#FF7CCBEE</Color>
    <Color x:Key="cBlue1">#FF6FC7F0</Color>
    <Color x:Key="cBlue2">#FF1F86C8</Color>
    <Color x:Key="cGreen1">#FFB6E77A</Color>
    <Color x:Key="cGreen2">#FF4CA22B</Color>
    <Color x:Key="cAmber1">#FFFFD97A</Color>
    <Color x:Key="cAmber2">#FFE08C1E</Color>
    <Color x:Key="cRed1">#FFFFA694</Color>
    <Color x:Key="cRed2">#FFC63C22</Color>

    <SolidColorBrush x:Key="Ink"    Color="{StaticResource cInk}"/>
    <SolidColorBrush x:Key="Deep"   Color="{StaticResource cDeep}"/>
    <SolidColorBrush x:Key="Muted"  Color="#FF2C5F7E"/>
    <SolidColorBrush x:Key="Line"   Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Glass"  Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="Glass2" Color="#59FFFFFF"/>

    <LinearGradientBrush x:Key="SkyBrush" StartPoint="0.12,0" EndPoint="0.72,1">
      <GradientStop Color="#E3F4FDFF" Offset="0"/>
      <GradientStop Color="#D895D9F6" Offset="0.30"/>
      <GradientStop Color="#D24DBBEC" Offset="0.60"/>
      <GradientStop Color="#D267D0C4" Offset="0.82"/>
      <GradientStop Color="#D897DC5F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopGloss" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#A0FFFFFF" Offset="0"/>
      <GradientStop Color="#42FFFFFF" Offset="0.55"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossBlue" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF8FD9F7" Offset="0"/>
      <GradientStop Color="#FF39A5DC" Offset="0.49"/>
      <GradientStop Color="#FF1B7FC0" Offset="0.51"/>
      <GradientStop Color="#FF39B0E4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossGreen" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFCBF08F" Offset="0"/>
      <GradientStop Color="#FF74C23C" Offset="0.49"/>
      <GradientStop Color="#FF4E9C22" Offset="0.51"/>
      <GradientStop Color="#FF7FCF43" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossAmber" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFE6A8" Offset="0"/>
      <GradientStop Color="#FFF0A93A" Offset="0.49"/>
      <GradientStop Color="#FFD5871B" Offset="0.51"/>
      <GradientStop Color="#FFF7B950" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossRed" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFB6A6" Offset="0"/>
      <GradientStop Color="#FFDD5C3E" Offset="0.49"/>
      <GradientStop Color="#FFB63B22" Offset="0.51"/>
      <GradientStop Color="#FFE0704F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Shine" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#B8FFFFFF" Offset="0"/>
      <GradientStop Color="#38FFFFFF" Offset="0.48"/>
      <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#EDFFFFFF" Offset="0"/>
      <GradientStop Color="#C4FFFFFF" Offset="0.45"/>
      <GradientStop Color="#B0EBF8FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ====================== ICONOS VECTORIALES ====================== -->
    <Geometry x:Key="icHome">M12,2.2 L22.4,11.6 L19.4,11.6 L19.4,21.4 L14.2,21.4 L14.2,15.2 L9.8,15.2 L9.8,21.4 L4.6,21.4 L4.6,11.6 L1.6,11.6 Z</Geometry>
    <Geometry x:Key="icScreen">M2,4 L22,4 L22,16.4 L2,16.4 Z M9.2,18.6 L14.8,18.6 L14.8,21 L9.2,21 Z M11,16.4 L13,16.4 L13,18.6 L11,18.6 Z</Geometry>
    <Geometry x:Key="icDisk">M3,4.6 L21,4.6 L21,9 L3,9 Z M3,10.8 L21,10.8 L21,15.2 L3,15.2 Z M3,17 L21,17 L21,21.4 L3,21.4 Z</Geometry>
    <Geometry x:Key="icBolt">M13.6,1.6 L4,13.4 L10.8,13.4 L9.8,22.4 L20.2,9.4 L13.2,9.4 Z</Geometry>
    <Geometry x:Key="icShield">M12,1.8 L21,5.6 L21,12.2 C21,17.2 17.2,21.2 12,22.4 C6.8,21.2 3,17.2 3,12.2 L3,5.6 Z</Geometry>
    <Geometry x:Key="icLock">M12,1.8 C15.4,1.8 18,4.4 18,7.8 L18,9.8 L15.6,9.8 L15.6,7.8 C15.6,5.8 14,4.2 12,4.2 C10,4.2 8.4,5.8 8.4,7.8 L8.4,9.8 L6,9.8 L6,7.8 C6,4.4 8.6,1.8 12,1.8 Z M4,10.8 L20,10.8 L20,22 L4,22 Z</Geometry>
    <Geometry x:Key="icRocket">M12,1.4 C15.4,4.8 17.2,9.2 17.2,13.4 L17.2,16.6 L14.2,19.6 L9.8,19.6 L6.8,16.6 L6.8,13.4 C6.8,9.2 8.6,4.8 12,1.4 Z M6.6,16 L2.6,20 L5.4,22.6 L8.2,20.4 Z M17.4,16 L21.4,20 L18.6,22.6 L15.8,20.4 Z</Geometry>
    <Geometry x:Key="icChart">M2.8,20.6 L7,20.6 L7,11 L2.8,11 Z M9.9,20.6 L14.1,20.6 L14.1,3.4 L9.9,3.4 Z M17,20.6 L21.2,20.6 L21.2,14.4 L17,14.4 Z</Geometry>
    <Geometry x:Key="icGlobe">M12,1.6 C17.7,1.6 22.4,6.3 22.4,12 C22.4,17.7 17.7,22.4 12,22.4 C6.3,22.4 1.6,17.7 1.6,12 C1.6,6.3 6.3,1.6 12,1.6 Z</Geometry>
    <Geometry x:Key="icGlobeLines">M1.9,9 L22.1,9 M1.9,15 L22.1,15 M12,1.7 C15.2,5 15.2,19 12,22.3 M12,1.7 C8.8,5 8.8,19 12,22.3</Geometry>
    <Geometry x:Key="icDoc">M5,2.2 L15.4,2.2 L19,5.8 L19,21.8 L5,21.8 Z</Geometry>
    <Geometry x:Key="icDocLines">M8,9 L16,9 M8,12.6 L16,12.6 M8,16.2 L13,16.2</Geometry>
    <Geometry x:Key="icVortex">M12,2 C17.5,2 22,6.5 22,12 C22,17.5 17.5,22 12,22 C6.5,22 2,17.5 2,12 C2,6.5 6.5,2 12,2 Z M12,5 C8.1,5 5,8.1 5,12 C5,15.9 8.1,19 12,19 C15.9,19 19,15.9 19,12 C19,8.1 15.9,5 12,5 Z M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z M12,10.5 C11.2,10.5 10.5,11.2 10.5,12 C10.5,12.8 11.2,13.5 12,13.5 C12.8,13.5 13.5,12.8 13.5,12 C13.5,11.2 12.8,10.5 12,10.5 Z</Geometry>
    <Geometry x:Key="icTrash">M6,7 L6,20.4 C6,21.3 6.7,22 7.6,22 L16.4,22 C17.3,22 18,21.3 18,20.4 L18,7 Z M4,4 L9,4 L10,2 L14,2 L15,4 L20,4 L20,6 L4,6 Z M9,9 L9,19 M12,9 L12,19 M15,9 L15,19</Geometry>
    <Geometry x:Key="icKey">M7,10 C7,7.8 8.8,6 11,6 C13.2,6 15,7.8 15,10 C15,11.5 14.2,12.8 13,13.6 L13,18 L11,20 L9,18 L9,13.6 C7.8,12.8 7,11.5 7,10 Z M11,8 C9.9,8 9,8.9 9,10 C9,11.1 9.9,12 11,12 C12.1,12 13,11.1 13,10 C13,8.9 12.1,8 11,8 Z</Geometry>

    <!-- Estilo comun de los iconos de navegacion -->
    <Style x:Key="NavIcon" TargetType="Path">
      <Setter Property="Width" Value="19"/>
      <Setter Property="Height" Value="19"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{StaticResource GlossBlue}"/>
      <Setter Property="Stroke" Value="#B3FFFFFF"/>
      <Setter Property="StrokeThickness" Value="0.7"/>
    </Style>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="2"
                      Direction="270" Opacity="0.28" Color="#FF0A3A56"/>

    <!-- ========================= BOTON BRILLANTE ====================== -->
    <Style x:Key="Gloss" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource GlossBlue}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="10" Background="#00FFFFFF" Margin="-3"/>
              <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                      BorderBrush="#59FFFFFF" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                <Grid>
                  <Border CornerRadius="8,8,14,14" Margin="1,1,1,0" VerticalAlignment="Top"
                          Height="17" Background="{StaticResource Shine}"/>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Background" Value="#3DFFFFFF"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#B3FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1F86C8"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="RenderTransform">
                  <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                </Setter>
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GlossGreenBtn" TargetType="Button" BasedOn="{StaticResource Gloss}">
      <Setter Property="Background" Value="{StaticResource GlossGreen}"/>
    </Style>
    <Style x:Key="GlossAmberBtn" TargetType="Button" BasedOn="{StaticResource Gloss}">
      <Setter Property="Background" Value="{StaticResource GlossAmber}"/>
    </Style>
    <Style x:Key="GlossRedBtn" TargetType="Button" BasedOn="{StaticResource Gloss}">
      <Setter Property="Background" Value="{StaticResource GlossRed}"/>
    </Style>
    <Style x:Key="GlossBig" TargetType="Button" BasedOn="{StaticResource Gloss}">
      <Setter Property="Height" Value="62"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Padding" Value="34,0"/>
    </Style>

    <!-- ========================== BOTON PLANO ========================= -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="#66FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#AAFFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1F86C8"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ====================== BOTONES DE LA VENTANA =================== -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="7" Background="#00FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#7AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#AAFFFFFF"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1F86C8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ========================= NAVEGACION =========================== -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="10,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="10" Background="#00FFFFFF" BorderThickness="1" BorderBrush="#00FFFFFF">
              <Grid>
                <Border x:Name="sel" CornerRadius="10" Opacity="0">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#E6FFFFFF" Offset="0"/>
                      <GradientStop Color="#A6E7F7FF" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Rectangle x:Name="bar" Width="4" HorizontalAlignment="Left" Margin="0,7" RadiusX="2" RadiusY="2" Opacity="0"
                           Fill="{StaticResource GlossBlue}"/>
                <ContentPresenter VerticalAlignment="Center" Margin="14,0,8,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#4DFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="sel" Property="Opacity" Value="1"/>
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1F86C8"/>
                <Setter TargetName="bar" Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ========================== INTERRUPTOR ========================= -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="track" CornerRadius="13" Background="#59FFFFFF" BorderBrush="#8CFFFFFF" BorderThickness="1"/>
              <Border x:Name="on" CornerRadius="13" Opacity="0" Background="{StaticResource GlossGreen}" BorderBrush="#8CFFFFFF" BorderThickness="1"/>
              <Ellipse x:Name="knob" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0"
                       Effect="{StaticResource SoftShadow}">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFD8ECF7" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="on" Property="Opacity" Value="1"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================ CASILLA =========================== -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Grid Width="19" Height="19" VerticalAlignment="Center">
                <Border x:Name="box" CornerRadius="5" Background="#B3FFFFFF" BorderBrush="#8C2E86B8" BorderThickness="1"/>
                <Border x:Name="fill" CornerRadius="5" Opacity="0" Background="{StaticResource GlossBlue}" BorderBrush="#8CFFFFFF" BorderThickness="1"/>
                <Path x:Name="tick" Opacity="0" Stretch="Uniform" Width="11" Height="11" Margin="0,1,0,0"
                      Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 0,5 L 4,9 L 12,0"/>
              </Grid>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                <Setter TargetName="tick" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#FF1F86C8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================ TARJETA =========================== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="#80FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
    </Style>

    <!-- ============================= TEXTOS =========================== -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============================ PROGRESO ========================== -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="6" Background="#59FFFFFF" BorderBrush="#73FFFFFF" BorderThickness="1">
              <Grid>
                <Border x:Name="PART_Track"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5" Margin="1"
                        Background="{StaticResource GlossBlue}">
                  <Border CornerRadius="5,5,8,8" VerticalAlignment="Top" Height="4" Margin="1,1,1,0"
                          Background="#8CFFFFFF"/>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================= LISTAS =========================== -->
    <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border Background="#4DFFFFFF" BorderBrush="#59FFFFFF" BorderThickness="0,0,1,1">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" Background="#00FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" CornerRadius="4">
              <GridViewRowPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#59FFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#73D6F0FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Lst" TargetType="ListView">
      <Setter Property="Background" Value="#40FFFFFF"/>
      <Setter Property="BorderBrush" Value="#66FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource RowStyle}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ============================= CAMPOS =========================== -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="8" Background="#B3FFFFFF" BorderBrush="#8CFFFFFF" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1F86C8"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==================== ANOTHER STORE RESOURCES ==================== -->
    <SolidColorBrush x:Key="CardBg"     Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#66FFFFFF"/>

    <Style x:Key="Combo" TargetType="ComboBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============================ PESTANAS ========================== -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0" HorizontalAlignment="Left"/>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Deep}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="bd" CornerRadius="9,9,0,0" Margin="0,0,4,0" Padding="16,7"
                    Background="#3DFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1,1,1,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#6BFFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#B8FFFFFF"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#8CFFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ========================== BARRA DE SCROLL ===================== -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="#1AFFFFFF">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="5" Margin="2,0" Background="#7A2E86B8"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- ================================================================= -->
  <Grid>
    <!-- Capa de color sobre el acrilico de Windows -->
    <Rectangle x:Name="BgSky" Fill="{StaticResource SkyBrush}"/>
    <!-- Barrido brillante superior, tipo cristal -->
    <Rectangle x:Name="BgGloss" Height="170" VerticalAlignment="Top" Fill="{StaticResource TopGloss}" IsHitTestVisible="False"/>

    <!-- Burbujas decorativas -->
    <Canvas x:Name="BgBubbles" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Canvas.Left="-60" Canvas.Top="380" Width="300" Height="300" Opacity="0.30">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.35,0.3">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#66BEEBFF" Offset="0.55"/>
            <GradientStop Color="#0099DDFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="820" Canvas.Top="-70" Width="380" Height="380" Opacity="0.26">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.35,0.3">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#66C9F5A0" Offset="0.55"/>
            <GradientStop Color="#00AEEA6E" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Canvas.Left="600" Canvas.Top="470" Width="180" Height="180" Opacity="0.22">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.35,0.3">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#5EB3E8FF" Offset="0.6"/>
            <GradientStop Color="#0080D0FF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>

    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
      </Grid.RowDefinitions>

      <!-- ========================= BARRA SUPERIOR ==================== -->
      <Grid Grid.Row="0">
        <Border Background="#57FFFFFF" BorderBrush="#5EFFFFFF" BorderThickness="0,0,0,1"/>
        <DockPanel LastChildFill="False" Margin="14,0">
          <Ellipse Width="22" Height="22" VerticalAlignment="Center" DockPanel.Dock="Left">
            <Ellipse.Fill>
              <RadialGradientBrush GradientOrigin="0.3,0.25">
                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                <GradientStop Color="#FF6FC7F0" Offset="0.5"/>
                <GradientStop Color="#FF1F86C8" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="Another's Toolbox" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                     FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
          <TextBlock x:Name="TbHeaderHint" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{StaticResource Muted}" Text="mantenimiento de equipos Windows 11"/>

          <Button x:Name="BtnClose" Style="{StaticResource Chrome}" DockPanel.Dock="Right" Content="&#x2715;" FontSize="12"
                  AutomationProperties.Name="Cerrar ventana"/>
          <Button x:Name="BtnMax"   Style="{StaticResource Chrome}" DockPanel.Dock="Right" Content="&#x25A1;"
                  AutomationProperties.Name="Maximizar ventana"/>
          <Button x:Name="BtnMin"   Style="{StaticResource Chrome}" DockPanel.Dock="Right" Content="&#x2013;"
                  AutomationProperties.Name="Minimizar ventana"/>
        </DockPanel>
      </Grid>

      <!-- =========================== CUERPO ========================== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="238"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================== LATERAL ======================== -->
        <Grid Grid.Column="0">
          <Border Background="#4DFFFFFF" BorderBrush="#59FFFFFF" BorderThickness="0,0,1,0"/>
          <DockPanel>
            <Border DockPanel.Dock="Bottom" Margin="12,8,12,12" Padding="12,10" CornerRadius="12"
                    Background="#59FFFFFF" BorderBrush="#73FFFFFF" BorderThickness="1">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Modo avanzado" VerticalAlignment="Center" FontSize="12.5"
                             Foreground="{StaticResource Deep}" FontWeight="SemiBold"/>
                  <ToggleButton x:Name="SwAdvanced" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                  <TextBlock Text="Contraste alto" VerticalAlignment="Center" FontSize="12.5"
                             Foreground="{StaticResource Deep}" FontWeight="SemiBold"/>
                  <ToggleButton x:Name="SwContrast" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                AutomationProperties.Name="Contraste alto"/>
                </DockPanel>
                <TextBlock x:Name="TbModeHint" Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="11"
                           Text="Modo basico: un clic y listo."/>
                <Rectangle Height="1" Fill="#59FFFFFF" Margin="0,9"/>
                <TextBlock x:Name="TbAdminBadge" FontSize="11" Foreground="{StaticResource Muted}"
                           Text="Comprobando permisos..." TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="NavPanel" Margin="0,10,0,0">
                <RadioButton x:Name="NavHome"     Style="{StaticResource Nav}" Tag="Home"     IsChecked="True">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icHome}"/>
                    <TextBlock Text="Inicio" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAnyDesk"  Style="{StaticResource Nav}" Tag="AnyDesk">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icScreen}"/>
                    <TextBlock Text="Asistencia (AnyDesk)" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>

                <TextBlock x:Name="TbAdvHeader" Text="AVANZADO" Margin="24,14,0,4" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>

                <RadioButton x:Name="NavDisk"     Style="{StaticResource Nav}" Tag="Disk"     Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icDisk}"/>
                    <TextBlock Text="Espacio en disco" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTweaks"   Style="{StaticResource Nav}" Tag="Tweaks"   Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icBolt}"/>
                    <TextBlock Text="Optimizar Windows" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavPrivacy"  Style="{StaticResource Nav}" Tag="Privacy"  Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icShield}"/>
                    <TextBlock Text="Telemetria" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavPrivRecs" Style="{StaticResource Nav}" Tag="PrivRecs" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icKey}"/>
                    <TextBlock Text="Recomendaciones" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavDebloat"  Style="{StaticResource Nav}" Tag="Debloat"  Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icTrash}"/>
                    <TextBlock Text="Debloat Apps" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavApps"     Style="{StaticResource Nav}" Tag="Apps"     Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icDoc}"/>
                    <TextBlock Text="Aplicaciones" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavEset"     Style="{StaticResource Nav}" Tag="Eset"     Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icLock}"/>
                    <TextBlock Text="Firewall ESET" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavStartup"  Style="{StaticResource Nav}" Tag="Startup"  Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icRocket}"/>
                    <TextBlock Text="Arranque" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavProcess"  Style="{StaticResource Nav}" Tag="Process"  Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icChart}"/>
                    <TextBlock Text="Procesos y RAM" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavVortex"   Style="{StaticResource Nav}" Tag="Vortex"   Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icVortex}"/>
                    <TextBlock Text="Vortex Mods" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSystem"   Style="{StaticResource Nav}" Tag="System"   Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="19" Height="19" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource icGlobe}" Fill="{StaticResource GlossBlue}" Stroke="#B3FFFFFF" StrokeThickness="0.7"/><Path Data="{StaticResource icGlobeLines}" Stroke="#E6FFFFFF" StrokeThickness="1.4"/></Canvas></Viewbox>
                    <TextBlock Text="Navegador y energia" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLog"      Style="{StaticResource Nav}" Tag="Log"      Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="19" Height="19" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource icDoc}" Fill="{StaticResource GlossBlue}" Stroke="#B3FFFFFF" StrokeThickness="0.7"/><Path Data="{StaticResource icDocLines}" Stroke="#E6FFFFFF" StrokeThickness="1.4"/></Canvas></Viewbox>
                    <TextBlock Text="Registro y deshacer" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>

                <TextBlock Text="ANOTHER STORE" Margin="24,14,0,4" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>

                <RadioButton x:Name="NavStore"    Style="{StaticResource Nav}" Tag="Store">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="{StaticResource icGlobe}"/>
                    <TextBlock Text="Another Store" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>

        <!-- ======================= CONTENIDO ======================= -->
        <Grid Grid.Column="1" x:Name="PagesHost" Margin="20,16,20,10">

          <!-- ======================== INICIO ======================== -->
          <Grid x:Name="PageHome">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock x:Name="TbHello" Style="{StaticResource H1}" Text="Poner a punto este equipo"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Un solo boton limpia el disco, optimiza Windows 11, corta la telemetria, deja el firewall de ESET listo y quita programas del arranque."/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource H2}" Text="Mantenimiento completo" Margin="0,0,0,4"/>
                  <TextBlock Style="{StaticResource Sub}" x:Name="TbOneClickInfo"
                             Text="Crea un punto de restauracion y aplica todo lo recomendado. Tarda entre 3 y 10 minutos."/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="ChkRestore" Style="{StaticResource Check}" IsChecked="True" Content="Punto de restauracion"/>
                    <CheckBox x:Name="ChkEsetInclude" Style="{StaticResource Check}" IsChecked="True" Margin="18,0,0,0" Content="Firewall ESET"/>
                    <CheckBox x:Name="ChkZenInclude" Style="{StaticResource Check}" IsChecked="True" Margin="18,0,0,0" Content="Zen predeterminado"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnOneClick" Style="{StaticResource GlossBig}"
                        Content="Optimizar ahora" VerticalAlignment="Center" Margin="20,0,0,0"/>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Estado del equipo"/>
                <ItemsControl x:Name="IcDisks" Margin="0,0,0,14">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                  Background="{StaticResource GlossBlue}" BorderBrush="#59FFFFFF" BorderThickness="1">
                            <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource Deep}"/>
                            <ProgressBar Style="{StaticResource Bar}" Margin="0,6,0,4"
                                         Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource Sub}" FontSize="11.5">
                              <Run Text="{Binding UsedText, Mode=OneWay}"/><Run Text=" usados de "/><Run Text="{Binding TotalText, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding FreeText}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
                            <TextBlock Text="libres" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource H2}" Text="Diagnostico rapido"/>
                <UniformGrid Columns="2">
                  <Border Style="{StaticResource Card}" Margin="0,0,6,8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Telemetria" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
                      <TextBlock x:Name="TbStatPrivacy" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="6,0,0,8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Inicio rapido" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
                      <TextBlock x:Name="TbStatFast" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,6,8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Firewall ESET" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
                      <TextBlock x:Name="TbStatEset" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="6,0,0,8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Navegador" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
                      <TextBlock x:Name="TbStatZen" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,6,8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Memoria" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
                      <TextBlock x:Name="TbStatRam" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="6,0,0,8" Padding="14">
                    <StackPanel>
                      <TextBlock Text="Equipo" FontWeight="SemiBold" Foreground="{StaticResource Deep}"/>
                      <TextBlock x:Name="TbStatPc" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="-"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ======================== ANYDESK ======================= -->
          <Grid x:Name="PageAnyDesk" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Asistencia remota con AnyDesk"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="AnyDesk permite que alguien de confianza vea tu pantalla y te ayude. Sigue los pasos en orden."/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock x:Name="TbAnyState" Style="{StaticResource H2}" Text="Comprobando..." Margin="0,0,0,4"/>
                  <TextBlock x:Name="TbAnyId" Style="{StaticResource Sub}" Text=""/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="BtnAnyDownload" Style="{StaticResource GlossGreenBtn}" Content="1. Descargar AnyDesk"/>
                  <Button x:Name="BtnAnyFolder" Style="{StaticResource Ghost}" Content="Abrir Descargas" Margin="8,0,0,0"/>
                  <Button x:Name="BtnAnyOpen" Style="{StaticResource Gloss}" Content="Abrir AnyDesk" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="IcAnySteps">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="46"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"
                                Background="{StaticResource GlossGreen}" BorderBrush="#59FFFFFF" BorderThickness="1">
                          <TextBlock Text="{Binding N}" Foreground="White" FontWeight="Bold" FontSize="15"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                          <TextBlock Text="{Binding T}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Deep}"/>
                          <TextBlock Text="{Binding D}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- ========================= DISCO ======================== -->
          <Grid x:Name="PageDisk" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Espacio en disco"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Analiza que ocupa espacio, limpia basura del sistema y busca los archivos mas pesados."/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnDiskScan"    Style="{StaticResource Gloss}"        Content="Analizar basura"/>
              <Button x:Name="BtnDiskClean"   Style="{StaticResource GlossGreenBtn}" Content="Limpiar seleccionado" Margin="8,0,0,0"/>
              <Button x:Name="BtnDiskDism"    Style="{StaticResource Ghost}"        Content="Limpiar componentes (DISM)" Margin="8,0,0,0"/>
              <TextBlock x:Name="TbDiskTotal" VerticalAlignment="Center" Margin="16,0,0,0"
                         FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Text=""/>
            </StackPanel>

            <TabControl Grid.Row="2" Margin="0,14,0,0" Background="Transparent" BorderThickness="0">
              <TabItem Header="Basura del sistema">
                <ListView x:Name="LvClean" Style="{StaticResource Lst}" Margin="0,8,0,0">
                  <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                      <GridViewColumn Width="42">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                      <GridViewColumn Header="Ubicacion" Width="290" DisplayMemberBinding="{Binding Name}"/>
                      <GridViewColumn Header="Tamano"    Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                      <GridViewColumn Header="Tipo"      Width="90"  DisplayMemberBinding="{Binding Category}"/>
                      <GridViewColumn Header="Detalle"   Width="330" DisplayMemberBinding="{Binding Detail}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
              </TabItem>

              <TabItem Header="Archivos pesados">
                <Grid Margin="0,8,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Carpeta:" VerticalAlignment="Center" Foreground="{StaticResource Deep}" FontSize="12.5"/>
                    <TextBox x:Name="TxtScanPath" Style="{StaticResource Field}" Width="300" Margin="8,0,0,0"/>
                    <TextBlock Text="Minimo MB:" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Deep}" FontSize="12.5"/>
                    <TextBox x:Name="TxtScanMin" Style="{StaticResource Field}" Width="70" Margin="8,0,0,0" Text="100"/>
                    <Button x:Name="BtnScanFiles"   Style="{StaticResource Gloss}"  Content="Buscar archivos" Margin="10,0,0,0"/>
                    <Button x:Name="BtnScanFolders" Style="{StaticResource Ghost}"  Content="Medir carpetas" Margin="8,0,0,0"/>
                  </StackPanel>
                  <ListView Grid.Row="1" x:Name="LvBig" Style="{StaticResource Lst}">
                    <ListView.View>
                      <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                        <GridViewColumn Width="42">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nombre" Width="280" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Tamano" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="Fecha"  Width="100" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="Ruta"   Width="380" DisplayMemberBinding="{Binding Detail}"/>
                      </GridView>
                    </ListView.View>
                  </ListView>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                              HorizontalAlignment="Right" Margin="0,0,14,14">
                    <Button x:Name="BtnOpenFile" Style="{StaticResource Ghost}" Content="Abrir ubicacion"/>
                    <Button x:Name="BtnDeleteBig" Style="{StaticResource GlossAmberBtn}" Content="Enviar a la papelera" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>

          <!-- ======================== TWEAKS ======================== -->
          <Grid x:Name="PageTweaks" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Optimizar Windows 11"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Quita lo que sobra sin tocar la transparencia ni las animaciones del sistema."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnTweakApply" Style="{StaticResource GlossGreenBtn}" Content="Aplicar seleccionado"/>
              <Button x:Name="BtnTweakRecommended" Style="{StaticResource Ghost}" Content="Marcar recomendados" Margin="8,0,0,0"/>
              <Button x:Name="BtnRestartExplorer" Style="{StaticResource Ghost}" Content="Reiniciar Explorador" Margin="8,0,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvTweaks" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Optimizacion" Width="330" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Efecto"       Width="420" DisplayMemberBinding="{Binding Detail}"/>
                  <GridViewColumn Header=""             Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ======================= PRIVACIDAD ===================== -->
          <Grid x:Name="PagePrivacy" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Telemetria y privacidad"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Corta el envio de datos a Microsoft. No toca Windows Defender, Windows Update ni la activacion."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnPrivApply" Style="{StaticResource GlossGreenBtn}" Content="Aplicar seleccionado"/>
              <Button x:Name="BtnPrivRecommended" Style="{StaticResource Ghost}" Content="Marcar recomendados" Margin="8,0,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvPrivacy" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Ajuste" Width="360" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Que hace" Width="400" DisplayMemberBinding="{Binding Detail}"/>
                  <GridViewColumn Header="" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ============= RECOMENDACIONES DE PRIVACIDAD ============ -->
          <Grid x:Name="PagePrivRecs" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
              <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Recomendaciones de privacidad"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16"
                           Text="Consejos y herramientas para proteger tus cuentas y datos personales."/>

                <!-- Card 1: HaveIBeenPwned -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource H2}" Text="Comprueba si tus correos han sido filtrados"/>
                      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                 Text="Have I Been Pwned te dice si alguna de tus cuentas aparecio en una brecha de datos conocida. Es gratuito y no requiere registro."/>
                    </StackPanel>
                    <Button x:Name="BtnHibpOpen" Grid.Column="1" Style="{StaticResource Gloss}"
                            Content="Abrir HaveIBeenPwned" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>

                <!-- Card 2: Zen Browser -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource H2}" Text="Navegador Zen Browser"/>
                      <TextBlock x:Name="TbPrivRecZenState" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Comprobando..."/>
                      <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="11"
                                 Text="Zen es un navegador basado en Firefox, centrado en la privacidad. Sin telemetria, sin rastreo."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Button x:Name="BtnPrivRecZenSet" Style="{StaticResource GlossGreenBtn}"
                              Content="Usar como predeterminado" Visibility="Collapsed"/>
                      <Button x:Name="BtnPrivRecZenDownload" Style="{StaticResource Gloss}"
                              Content="Descargar Zen" Visibility="Collapsed"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Card 3: uBlock Origin (solo si Zen instalado) -->
                <Border x:Name="CardUblock" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource H2}" Text="uBlock Origin en Zen"/>
                      <TextBlock x:Name="TbPrivRecUblockState" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="Comprobando..."/>
                      <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="11"
                                 Text="El mejor bloqueador de anuncios y rastreadores. Ligero, de codigo abierto, sin intereses comerciales."/>
                    </StackPanel>
                    <Button x:Name="BtnPrivRecUblockInstall" Grid.Column="1" Style="{StaticResource Gloss}"
                            Content="Instalar uBlock Origin" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>

                <!-- Card 4: LastPass -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource H2}" Text="Gestor de contrasenas: LastPass"/>
                      <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                 Text="Usa una contrasena unica para cada servicio. LastPass las genera, guarda y autocompleta. La version gratuita cubre un dispositivo."/>
                    </StackPanel>
                    <Button x:Name="BtnLastPassOpen" Grid.Column="1" Style="{StaticResource Gloss}"
                            Content="Ir a LastPass" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>

                <!-- ===== BOVEDA DE CONTRASENAS ===== -->
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource H2}" Text="Almacen local de contrasenas"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                   Text="Guarda contrasenas cifradas con tu cuenta de Windows. Se desbloquea con Windows Hello (huella, PIN o rostro). Los datos nunca salen de este equipo."/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="BtnVaultUnlock" Style="{StaticResource GlossGreenBtn}"
                                Content="Desbloquear con Windows Hello"/>
                        <Button x:Name="BtnVaultLock" Style="{StaticResource GlossRedBtn}"
                                Content="Bloquear" Margin="8,0,0,0" Visibility="Collapsed"/>
                      </StackPanel>
                    </Grid>

                    <!-- Estado bloqueado -->
                    <TextBlock x:Name="TbVaultLockedMsg" Style="{StaticResource Sub}" Margin="0,12,0,0"
                               Text="Almacen bloqueado. Pulsa Desbloquear para acceder." Foreground="{StaticResource Muted}"/>

                    <!-- Contenido de la boveda (oculto hasta desbloquear) -->
                    <StackPanel x:Name="SpVaultContent" Visibility="Collapsed" Margin="0,14,0,0">

                      <!-- Generador -->
                      <Border CornerRadius="10" Background="#40FFFFFF" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Style="{StaticResource H2}" Text="Generador de contrasenas seguras" Margin="0,0,0,8"/>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGenPassword" Grid.Column="0" Style="{StaticResource Field}"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="14"
                                     Text="Pulsa Generar para crear una contrasena"/>
                            <Button x:Name="BtnGenPassword" Grid.Column="1" Style="{StaticResource Gloss}"
                                    Content="Generar" Margin="8,0,0,0"/>
                            <Button x:Name="BtnGenCopy" Grid.Column="2" Style="{StaticResource Ghost}"
                                    Content="Copiar" Margin="8,0,0,0"/>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="ChkGenSpecial" Style="{StaticResource Check}" Content="Caracteres especiales" IsChecked="True"/>
                            <TextBlock x:Name="TbGenLength" Style="{StaticResource Sub}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" Text="Longitud: 20"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <!-- Formulario agregar entrada -->
                      <Border CornerRadius="10" Background="#40FFFFFF" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                          <TextBlock Style="{StaticResource H2}" Text="Anadir entrada" Margin="0,0,0,8"/>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Servicio:" Foreground="{StaticResource Deep}" FontSize="12" Margin="0,0,8,2"/>
                            <TextBox x:Name="TxtVaultAppName" Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}"
                                     Margin="0,0,8,8" Tag="Nombre del servicio (ej: Netflix)"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Correo:" Foreground="{StaticResource Deep}" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtVaultEmail" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                                     Margin="0,0,0,8" Tag="Correo electronico"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrasena:" Foreground="{StaticResource Deep}" FontSize="12" Margin="0,0,8,2"/>
                            <TextBox x:Name="TxtVaultPassword" Grid.Row="3" Grid.Column="0" Style="{StaticResource Field}"
                                     Margin="0,0,8,8" FontFamily="Consolas" Tag="Contrasena"/>
                            <Button x:Name="BtnVaultGenForEntry" Grid.Row="3" Grid.Column="1" Style="{StaticResource Ghost}"
                                    Content="Generar contrasena" Margin="0,0,0,8" VerticalAlignment="Bottom"/>
                            <Button x:Name="BtnVaultAdd" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource GlossGreenBtn}" Content="Guardar entrada" Margin="0,4,0,0"/>
                          </Grid>
                        </StackPanel>
                      </Border>

                      <!-- Lista de entradas -->
                      <ListView x:Name="LvVault" Style="{StaticResource Lst}" MaxHeight="320">
                        <ListView.View>
                          <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                            <GridViewColumn Header="Servicio"   Width="160" DisplayMemberBinding="{Binding AppName}"/>
                            <GridViewColumn Header="Correo"     Width="200" DisplayMemberBinding="{Binding Email}"/>
                            <GridViewColumn Header="Contrasena" Width="140" DisplayMemberBinding="{Binding MaskedPassword}"/>
                            <GridViewColumn Header="Modificado" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
                          </GridView>
                        </ListView.View>
                      </ListView>

                      <!-- Botones de accion sobre entrada seleccionada -->
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnVaultCopyPw" Style="{StaticResource Gloss}" Content="Copiar contrasena"/>
                        <Button x:Name="BtnVaultCopyEmail" Style="{StaticResource Ghost}" Content="Copiar correo" Margin="8,0,0,0"/>
                        <Button x:Name="BtnVaultDelete" Style="{StaticResource GlossRedBtn}" Content="Eliminar entrada" Margin="8,0,0,0"/>
                      </StackPanel>

                      <TextBlock x:Name="TbVaultCount" Style="{StaticResource Sub}" Margin="0,8,0,0" Text=""/>
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ========================= DEBLOAT ====================== -->
          <Grid x:Name="PageDebloat" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Debloat Apps y Features"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Quita bloatware preinstalado y toggles de Windows Features. La remocion de apps es parcialmente reversible via winget/Store."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnDebloatApply" Style="{StaticResource GlossGreenBtn}" Content="Aplicar seleccionado"/>
              <Button x:Name="BtnDebloatRecommended" Style="{StaticResource Ghost}" Content="Marcar recomendados" Margin="8,0,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvDebloat" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Nombre" Width="260" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Tipo" Width="80" DisplayMemberBinding="{Binding Category}"/>
                  <GridViewColumn Header="Info" Width="500" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ====================== APLICACIONES ==================== -->
          <Grid x:Name="PageApps" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Aplicaciones instaladas"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Desinstala apps del usuario y limpia su cache (%LOCALAPPDATA%\Packages). Las apps del sistema estan protegidas y no se listan. Se registra como revertir cada desinstalacion."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnAppsScan"    Style="{StaticResource Gloss}" Content="Analizar"/>
              <Button x:Name="BtnAppsUninstall" Style="{StaticResource GlossRedBtn}" Content="Desinstalar seleccionado" Margin="8,0,0,0"/>
              <Button x:Name="BtnAppsClearCache" Style="{StaticResource GlossAmberBtn}" Content="Limpiar cache seleccionada" Margin="8,0,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvApps" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Aplicacion" Width="280" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Version"   Width="100" DisplayMemberBinding="{Binding Status}"/>
                  <GridViewColumn Header="Cache"     Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="Ruta"      Width="420" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ========================== ESET ======================== -->
          <Grid x:Name="PageEset" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Firewall para ESET (KB332)"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Crea las reglas de salida con los puertos y direcciones que ESET necesita para activarse, actualizarse y usar LiveGrid."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnEsetApply" Style="{StaticResource GlossGreenBtn}" Content="Aplicar reglas"/>
              <Button x:Name="BtnEsetTest"  Style="{StaticResource Gloss}" Content="Probar conexion" Margin="8,0,0,0"/>
              <Button x:Name="BtnEsetRemove" Style="{StaticResource Ghost}" Content="Quitar reglas" Margin="8,0,0,0"/>
              <CheckBox x:Name="ChkEsetDns" Style="{StaticResource Check}" IsChecked="True" Margin="16,0,0,0"
                        VerticalAlignment="Center" Content="Resolver nombres por DNS (recomendado)"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvEset" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Grupo"     Width="170" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Servicio"  Width="330" DisplayMemberBinding="{Binding Detail}"/>
                  <GridViewColumn Header="Puertos"   Width="200" DisplayMemberBinding="{Binding Path}"/>
                  <GridViewColumn Header="Alcance"   Width="130" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header=""          Width="80"  DisplayMemberBinding="{Binding Status}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ========================= ARRANQUE ===================== -->
          <Grid x:Name="PageStartup" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Programas que arrancan con Windows"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Se desactivan igual que desde el Administrador de tareas, asi que se pueden volver a activar cuando quieras. Lo protegido (ESET, audio, tactil) nunca se toca."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnStartupScan"    Style="{StaticResource Gloss}" Content="Analizar"/>
              <Button x:Name="BtnStartupDisable" Style="{StaticResource GlossGreenBtn}" Content="Desactivar seleccionado" Margin="8,0,0,0"/>
              <Button x:Name="BtnStartupEnable"  Style="{StaticResource Ghost}" Content="Reactivar seleccionado" Margin="8,0,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvStartup" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsEnabled="{Binding Editable}"
                                  IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Programa" Width="220" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Estado"   Width="100" DisplayMemberBinding="{Binding Status}"/>
                  <GridViewColumn Header="Origen"   Width="150" DisplayMemberBinding="{Binding Category}"/>
                  <GridViewColumn Header="Nota"     Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="Comando"  Width="330" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ======================== PROCESOS ====================== -->
          <Grid x:Name="PageProcess" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Procesos y memoria"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Lo marcado como Sistema no se puede tocar. Telemetria y Prescindible se pueden cerrar; la telemetria ademas se puede dejar sin Internet."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnProcScan"  Style="{StaticResource Gloss}" Content="Analizar"/>
              <Button x:Name="BtnProcKill"  Style="{StaticResource GlossAmberBtn}" Content="Cerrar seleccionado" Margin="8,0,0,0"/>
              <Button x:Name="BtnProcBlock" Style="{StaticResource GlossRedBtn}" Content="Cerrar y bloquear red" Margin="8,0,0,0"/>
              <TextBlock x:Name="TbRam" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource Ink}" Text=""/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="LvProcess" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsEnabled="{Binding Editable}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Proceso"     Width="220" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="RAM"         Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="Clase"       Width="120" DisplayMemberBinding="{Binding Category}"/>
                  <GridViewColumn Header="Instancias"  Width="90"  DisplayMemberBinding="{Binding Status}"/>
                  <GridViewColumn Header="Descripcion" Width="370" DisplayMemberBinding="{Binding Detail}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ====================== VORTEX MODS ======================= -->
          <Grid x:Name="PageVortex" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Gestor de mods Vortex"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Vortex guarda los mods en 2 carpetas separadas: las descargas originales (.7z/.zip) que solo ocupan espacio, y los mods ya instalados/desplegados que el juego usa. Borrar las descargas es seguro y libera espacio sin tocar tus mods activos. Cierra Vortex antes de usar esta seccion."/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnVortexScan"     Style="{StaticResource Gloss}" Content="Analizar"/>
              <Button x:Name="BtnVortexRemove"   Style="{StaticResource GlossGreenBtn}" Content="Purgar seleccionado" Margin="8,0,0,0"/>
              <Button x:Name="BtnVortexFullClean" Style="{StaticResource Ghost}" Content="Eliminar Vortex completamente" Margin="8,0,0,0"/>
              <Button x:Name="BtnVortexSkyrimClean" Style="{StaticResource GlossRedBtn}" Content="Force Clean Skyrim" Margin="8,0,0,0"/>
            </StackPanel>

            <ListView Grid.Row="2" x:Name="LvVortex" Style="{StaticResource Lst}" Margin="0,14,0,0">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                  <GridViewColumn Width="42">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsEnabled="{Binding Editable}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Mod / Elemento" Width="260" DisplayMemberBinding="{Binding Name}"/>
                  <GridViewColumn Header="Juego"          Width="140" DisplayMemberBinding="{Binding Detail}"/>
                  <GridViewColumn Header="Tamano"         Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                  <GridViewColumn Header="Estado"         Width="100" DisplayMemberBinding="{Binding Status}"/>
                  <GridViewColumn Header="Categoria"      Width="120" DisplayMemberBinding="{Binding Category}"/>
                  <GridViewColumn Header="Ruta"           Width="350" DisplayMemberBinding="{Binding Path}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>

          <!-- ===================== NAVEGADOR / ENERGIA ============== -->
          <Grid x:Name="PageSystem" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Navegador y energia"/>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource H2}" Text="Zen Browser como predeterminado" Margin="0,0,0,4"/>
                      <TextBlock x:Name="TbZenState" Style="{StaticResource Sub}" Text="Comprobando..."/>
                      <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="11"
                                 Text="Si Zen no esta instalado no se cambia nada. Windows 11 puede pedir una confirmacion final en Configuracion."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button x:Name="BtnZenSet" Style="{StaticResource GlossGreenBtn}" Content="Poner Zen por defecto"/>
                      <Button x:Name="BtnZenSettings" Style="{StaticResource Ghost}" Content="Abrir Configuracion" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource H2}" Text="Inicio rapido de Windows" Margin="0,0,0,4"/>
                      <TextBlock x:Name="TbFastState" Style="{StaticResource Sub}" Text="Comprobando..."/>
                      <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" FontSize="11"
                                 Text="Con el inicio rapido activo el equipo nunca se apaga del todo: arrastra errores, drivers colgados y actualizaciones a medias."/>
                      <CheckBox x:Name="ChkHiber" Style="{StaticResource Check}" Margin="0,10,0,0"
                                Content="Desactivar tambien la hibernacion (libera varios GB)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button x:Name="BtnFastDisable" Style="{StaticResource GlossGreenBtn}" Content="Desactivar inicio rapido"/>
                      <Button x:Name="BtnFastEnable" Style="{StaticResource Ghost}" Content="Volver a activar" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Informacion del equipo"/>
                    <TextBlock x:Name="TbSysInfo" Style="{StaticResource Sub}" Text="-"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ========================= REGISTRO ===================== -->
          <Grid x:Name="PageStore" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Another Store" FontSize="22" FontWeight="SemiBold"
                         Foreground="#FF1F86C8" Margin="0,0,0,6"/>
              <TextBlock TextWrapping="Wrap" Foreground="#FF2C5F7E" Margin="0,0,0,14"
                         Text="Explora e instala las aplicaciones de Another Suite. Visita la tienda online o desinstala apps directamente desde aquí."/>

              <Border Background="#CCFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                      BorderBrush="#66FFFFFF" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Tienda Online" FontSize="15" FontWeight="SemiBold"
                             Foreground="#FF1F86C8" Margin="0,0,0,6"/>
                  <TextBlock TextWrapping="Wrap" Foreground="#FF2C5F7E" Margin="0,0,0,10"
                             Text="Visita anotherstore.neocities.org para descargar las últimas versiones y descubrir nuevas apps."/>
                  <Button x:Name="BtnStoreOpenWeb" Content="Abrir Another Store en el navegador"
                          Foreground="White" FontSize="14" FontWeight="SemiBold" Height="40"
                          Padding="14,7" Cursor="Hand" HorizontalAlignment="Left">
                    <Button.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6FC7F0" Offset="0"/>
                        <GradientStop Color="#FF1F86C8" Offset="1"/>
                      </LinearGradientBrush>
                    </Button.Background>
                  </Button>
                </StackPanel>
              </Border>

              <TextBlock Text="Desinstalar Apps de Another Suite" FontSize="15" FontWeight="SemiBold"
                         Foreground="#FF1F86C8" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap" Foreground="#FF2C5F7E" Margin="0,0,0,10"
                         Text="Selecciona las aplicaciones que deseas desinstalar. Se buscarán por nombre en el registro de Windows y se ejecutará su desinstalador si está disponible."/>

              <WrapPanel x:Name="StoreAppsPanel" Margin="0,0,0,14">
                <CheckBox x:Name="ChkStoreAudio"  Content="Audio"   Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreDraw"   Content="Draw"    Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreFinance" Content="Finance" Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreHub"    Content="Hub"     Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreMedia"  Content="Media"   Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStorePhoto"  Content="Photo"   Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStorePixel"  Content="Pixel"   Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStorePresent" Content="Present" Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreReader" Content="Reader"  Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreVault"  Content="Vault"   Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
                <CheckBox x:Name="ChkStoreWriter" Content="Writer"  Margin="0,0,14,8" Foreground="#FF2C5F7E"/>
              </WrapPanel>

              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStoreUninstall" Content="Desinstalar seleccionadas"
                        Foreground="White" FontSize="14" FontWeight="SemiBold" Height="40"
                        Padding="14,7" Cursor="Hand" Margin="0,0,10,0">
                  <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#FFFFA694" Offset="0"/>
                      <GradientStop Color="#FFC63C22" Offset="1"/>
                    </LinearGradientBrush>
                  </Button.Background>
                </Button>
                <Button x:Name="BtnStoreSelectAll" Content="Seleccionar todas"
                        Foreground="#FF0B5C8A" FontSize="13" Height="34" Padding="14,7"
                        Cursor="Hand" Background="Transparent"
                        BorderBrush="#59FFFFFF" BorderThickness="1"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="PageLog" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Style="{StaticResource H1}" Text="Registro y deshacer"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                         Text="Cada cambio del registro, servicio, tarea y regla de firewall queda anotado y se puede revertir."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="BtnUndoAll" Style="{StaticResource GlossRedBtn}" Content="Revertir todos los cambios"/>
              <Button x:Name="BtnOpenLog" Style="{StaticResource Ghost}" Content="Abrir carpeta de registros" Margin="8,0,0,0"/>
              <TextBlock x:Name="TbUndoCount" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                         Foreground="{StaticResource Ink}" Text=""/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="4">
              <ScrollViewer x:Name="SvLog" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcLog" Margin="10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11.5"
                                 Foreground="{StaticResource Deep}" TextWrapping="Wrap" Margin="0,1"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>

        </Grid>
      </Grid>

      <!-- ========================= BARRA INFERIOR ==================== -->
      <Grid Grid.Row="2">
        <Border Background="#57FFFFFF" BorderBrush="#5EFFFFFF" BorderThickness="0,1,0,0"/>
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="EllBusy" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Fill="#FF4CA22B"/>
          <TextBlock x:Name="TbStatus" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{StaticResource Deep}" Text="Listo" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="PbMain" Grid.Column="2" Style="{StaticResource Bar}" VerticalAlignment="Center"
                       Minimum="0" Maximum="100" Value="0"/>
        </Grid>
      </Grid>

    </Grid>
  </Grid>
</Window>
